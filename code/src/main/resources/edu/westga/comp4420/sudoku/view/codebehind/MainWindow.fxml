<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.sudoku.view.codebehind.MainWindow">
   <children>
      <Label fx:id="titleLabel" layoutX="175.0" layoutY="20.0" text="Sudoku Game">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <GridPane fx:id="boardGrid" gridLinesVisible="true" layoutX="60.0" layoutY="70.0" prefHeight="380.0" prefWidth="380.0">
      </GridPane>
      <Label fx:id="livesLabel" layoutX="60.0" layoutY="460.0" text="Lives: 3 / 3" />
      <Button layoutX="165.0" layoutY="480.0" mnemonicParsing="false" onAction="#handleNewGame" prefHeight="35.0" prefWidth="170.0" text="New Game" />
   </children>
</AnchorPane>