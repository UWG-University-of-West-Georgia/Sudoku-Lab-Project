<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="220.0" prefWidth="320.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.sudoku.view.codebehind.NewGameWindow">
   <children>
      <Label layoutX="75.0" layoutY="25.0" text="New Game">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="75.0" text="Choose the difficulty :" />
      <ComboBox fx:id="difficultyCombo" layoutX="40.0" layoutY="100.0" prefWidth="240.0" />
      <Button fx:id="startButton" layoutX="105.0" layoutY="155.0" mnemonicParsing="false" onAction="#handleStartGame" prefHeight="30.0" prefWidth="110.0" text="Start" />
   </children>
</AnchorPane>