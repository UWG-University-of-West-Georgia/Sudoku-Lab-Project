 <!-- Content -->
    <div class="container text-center my-5">
        <h1>Sudoku Lab - New Game Feature</h1>
        <p class="lead">Learn about the new game feature and how to select difficulty levels.</p>
    </div>

    <section class="container text-center mt-4">
        <h2>New Game & Difficulty Selection</h2>
        
        <p>To start a new game, follow these steps:</p>        
        <p><strong>Step 1 :</strong> Click on the "New Game" button in the application interface to open the setup window.</p>
        <p><strong>Step 2 :</strong> Choose your preferred difficulty level (Easy, Medium, Hard, or Expert) from the dropdown menu.</p>
        <p><strong>Step 3 :</strong> Click the "Start" button to generate and launch your fresh Sudoku puzzle.</p>
        
        <div class="my-4">
            <img src="/images/new_game.png" alt="Sudoku Application Running" class="img-fluid rounded shadow" style="max-width: 600px;">
        </div>
        
        <p class="mt-4">By clicking on the dropdown menu, users can choose their preferred difficulty level.</p>
        
        <div class="my-4">
            <img src="/images/choice_difficulty.png" alt="Sudoku Application Running" class="img-fluid rounded shadow mb-4" style="max-width: 600px;">
        </div>
    </section>

