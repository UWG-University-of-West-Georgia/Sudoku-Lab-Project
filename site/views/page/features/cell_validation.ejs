 <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
        <a class="navbar-brand" href="/">Sudoku Project</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ml-auto">
