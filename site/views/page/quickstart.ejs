 <!-- Content -->
    <div class="container my-5">
        <h1>Quick Start Guide</h1>
        <p>Welcome to the Quick Start Guide for the Sudoku Project!</p>
        <h2>Steps to Launch</h2>
        <ol>
            <li>
                <strong>Clone the repository:</strong>
                <p>Clone your GitHub repository to your local machine and navigate into the project folder.</p>
            </li>
            <li>
                <strong>Navigate to the code directory:</strong>
                <pre><code>cd code</code></pre>
            </li>
            <li>
                <strong>Compile and run the application:</strong>
                <p>Run the following Maven command to compile the project and start the JavaFX application:</p>
                <pre><code>mvn compile javafx:run</code></pre>
            </li>
        </ol>
        <section class="mb-5">
            <h2>Launch in Action</h2>
            <img src="/images/launch.png" alt="Sudoku Application Running" class="img-fluid rounded shadow" style="max-width: 600px;">
        </section>

        <h3>Requirements</h3>
        <ul>
            <li>Java Development Kit (JDK) installed</li>
            <li>Apache Maven installed</li>
        </ul>
      </div>

